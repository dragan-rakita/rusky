# ─── SQLite ───
# Local dev: rusky.db next to this file. Production: an absolute path outside the repo.
DATABASE_URL=rusky.db

# ─── Origin ───
# The address people open the app at. The API sits behind it at /api.
# Local dev: the web dev server, which proxies /api here.
ORIGIN=http://localhost:1389

# ─── Port ───
# Local dev 1390; production 3010 (Holocron has 3000), behind nginx.
PORT=1390

# ─── Better Auth ───
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The first account can always be created. After that sign-up is closed unless this is true.
REGISTRATION_OPEN=false
